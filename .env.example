# ===================================================
# NativeYard Environment Configuration
# ===================================================

# Google Gemini Vision API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# (Optional) Pl@ntNet API Key (from https://my.plantnet.org/)
PLANTNET_API_KEY=your_plantnet_api_key_here

# Supabase Project Configuration (from https://supabase.com/dashboard/project/<your-project>/settings/api)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_publishable_key_here
# Secret service_role key for backend admin tasks, seeding, and bypassing RLS (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

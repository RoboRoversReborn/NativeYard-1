# ===================================================
# NativeYard Environment Configuration (Firebase & Gemini)
# ===================================================

# Google Gemini Vision API Key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# (Optional) Pl@ntNet API Key (from https://my.plantnet.org/)
PLANTNET_API_KEY=your_plantnet_api_key_here

# Firebase Project Configuration (from Firebase Console -> Project Settings -> General -> Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# (Optional) Firebase Admin Service Account (for server administration & seeding scripts)
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Yard scan photos: stored under yard-photos/{userId}/...
    match /yard-photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Botanical plant images: public read, authenticated upload
    match /plants/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
